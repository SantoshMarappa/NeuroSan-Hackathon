{
    # `ns init` scaffolds this file into new projects as registries/manifest.hocon, and it is the
    # single source of truth for what a new project gets: InitCommand parses it and installs every
    # network declared below, together with each one's transitive dependencies. Adding a key here
    # installs that network. Keys are paths relative to registries/ in the neuro-san-studio source;
    # a key with no matching file there lands nothing on disk and is served as a 404.

    # Networks created by `agent_network_designer` are written under registries/generated/.
    # Fresh `ns init` projects start with an empty list.
    include "registries/generated/manifest.hocon",
    "basic/book_recommender.hocon": true,
    "basic/music_nerd.hocon": true,

    #
    # Agent Network Designer family. Installed so a brand-new project can design agent networks
    # immediately -- the nsflow NEW button, the tutorial, and the docs all assume the designer
    # is there.
    #
    "agent_network_designer.hocon": true,
    "streamforge.hocon": true,
    "agent_network_editor.hocon": {
        # Support network for agent_network_designer.
        # We want it served up, but not listed as a public agent network.
        "serve": true,
        "public": false
    },
    "agent_network_instructions_editor.hocon": {
        "serve": true,
        "public": false
    },
    "agent_network_query_generator.hocon": {
        "serve": true,
        "public": false
    },
    # The designer researches named organizations through this network before it designs
    # anything, so it must be served wherever the designer is. Public as well: it is a
    # general-purpose research network worth using on its own, as in the studio registry.
    "tools/internet_info_gatherer.hocon": true,

    # Generates test fixtures for an existing agent network.
    "agent_network_test_generator.hocon": true,

    #
    # CRUSE: the interactive UI that adapts itself to the user's and agents' needs.
    # Support networks for the interface, so served but not publicly listed.
    #
    "experimental/cruse_theme_agent.hocon": {
        "serve": true,
        "public": false
    },
    "experimental/cruse_widget_agent.hocon": {
        "serve": true,
        "public": false
    },
    "basic/advanced_calculator.hocon": true,
    "basic/book_recommender_multiple_llm_configs.hocon": true,
    "basic/coding_assistant.hocon": true,
    "basic/coffee_finder.hocon": true,
    "basic/coffee_finder_advanced.hocon": true,
    "basic/hello_world.hocon": true,
    "basic/internal_communication_skill.hocon": true,
    "basic/job_guessing_skill.hocon": true,
    "basic/music_nerd_llm_fallbacks.hocon": true,
    "basic/music_nerd_local.hocon": true,
    "basic/music_nerd_pro.hocon": true,
    "basic/music_nerd_pro_local.hocon": true,
    "basic/music_nerd_pro_sly.hocon": true,
    "basic/music_nerd_pro_sly_local.hocon": true,
    "basic/pii_middleware.hocon": true,
